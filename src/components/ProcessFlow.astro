---
/**
 * A numbered process graphic: a gradient wave connects the steps on desktop, with
 * cards alternating above and below it; on phones it becomes a vertical timeline.
 * Pure HTML/CSS plus one decorative inline SVG, so text stays real, selectable and
 * uses the site's own fonts and tokens.
 */
export interface FlowStep {
  title: string;
  body: string;
  /** Short chip shown under the title, e.g. a timing. */
  tag?: string;
  icon: 'form' | 'reply' | 'talk' | 'summary';
}

interface Props {
  steps: FlowStep[];
  label: string;
}

const { steps, label } = Astro.props as Props;

// Evenly spaced from the site's blue to its purple.
const colors = ['#5cc1ff', '#6d81ff', '#7e40ff', '#8f00ff'];

const icons: Record<FlowStep['icon'], string> = {
  form: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
  reply: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  talk: '<path d="M21 12a8 8 0 0 1-11.5 7.2L4 20l1-4.5A8 8 0 1 1 21 12z"/>',
  summary: '<path d="M7 3h8l4 4v14H7z"/><path d="M15 3v4h4"/><path d="M10 14l2 2 3-4"/>',
};
---

<div class="flow">
  <svg
    class="wave"
    viewBox="0 0 1000 96"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <linearGradient id="flow-grad" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#5cc1ff"></stop>
        <stop offset="1" stop-color="#8f00ff"></stop>
      </linearGradient>
    </defs>
    <path
      class="wave-glow"
      d="M125 48 C 170 104, 330 104, 375 48 C 420 -8, 580 -8, 625 48 C 670 104, 830 104, 875 48"
    ></path>
    <path
      class="wave-line"
      d="M125 48 C 170 104, 330 104, 375 48 C 420 -8, 580 -8, 625 48 C 670 104, 830 104, 875 48"
    ></path>
  </svg>

  <ol class="flow-list" aria-label={label}>
    {
      steps.map((s, i) => (
        <li class={`step ${i % 2 === 0 ? 'below' : 'above'}`} style={`--c: ${colors[i % colors.length]}`}>
          <div class="node" aria-hidden="true">
            <span>{i + 1}</span>
          </div>
          <div class="card">
            <svg
              class="icon"
              viewBox="0 0 24 24"
              width="26"
              height="26"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
              set:html={icons[s.icon]}
            />
            <h3>{s.title}</h3>
            {s.tag && <span class="tag">{s.tag}</span>}
            <p>{s.body}</p>
          </div>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .flow {
    position: relative;
  }
  .wave {
    display: none;
  }
  .flow-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* --- Phone: vertical timeline --- */
  .step {
    position: relative;
    display: grid;
    grid-template-columns: 52px 1fr;
    column-gap: 16px;
    padding-bottom: 20px;
  }
  .step:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 25px;
    top: 52px;
    bottom: 0;
    width: 2px;
    background: linear-gradient(var(--c), rgba(255, 255, 255, 0.1));
  }
  .node {
    grid-column: 1;
    grid-row: 1;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--surface-card-alt);
    border: 3px solid var(--c);
    box-shadow: 0 0 18px color-mix(in srgb, var(--c) 35%, transparent);
    font-family: var(--font-ui);
    font-size: 18px;
    font-weight: 700;
    color: var(--text-primary);
  }
  .card {
    grid-column: 2;
    grid-row: 1;
    position: relative;
    border: 1px solid var(--border);
    border-top: 2px solid var(--c);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    padding: 18px 18px 16px;
    color: var(--c);
  }
  .icon {
    display: block;
    margin-bottom: 10px;
  }
  .card h3 {
    margin: 0 0 8px;
    font-family: var(--font-ui);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--text-primary);
  }
  .tag {
    display: inline-block;
    margin: 0 0 10px;
    padding: 3px 10px;
    border-radius: 12px;
    border: 1px solid color-mix(in srgb, var(--c) 55%, transparent);
    background: color-mix(in srgb, var(--c) 12%, transparent);
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 600;
    color: var(--text-primary);
  }
  .card p {
    margin: 0;
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-muted);
  }

  /* --- Desktop: wave with cards alternating above and below --- */
  @media (min-width: 860px) {
    .wave {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      top: var(--slot);
      width: 100%;
      height: var(--wave-h);
      overflow: visible;
    }
    .wave-line,
    .wave-glow {
      fill: none;
      stroke: url(#flow-grad);
      stroke-linecap: round;
      vector-effect: non-scaling-stroke;
    }
    .wave-line {
      stroke-width: 3px;
    }
    .wave-glow {
      stroke-width: 10px;
      opacity: 0.14;
    }

    .flow {
      --slot: 280px;
      --wave-h: 96px;
    }
    .flow-list {
      display: grid;
      /* No column gap: node centres must sit exactly at 12.5%, 37.5%, ... to meet the wave. */
      grid-template-columns: repeat(4, 1fr);
    }
    .step {
      display: grid;
      grid-template-columns: 1fr;
      grid-template-rows: var(--slot) var(--wave-h) var(--slot);
      padding-bottom: 0;
      column-gap: 0;
    }
    .step::before {
      display: none;
    }
    .node {
      grid-column: 1;
      grid-row: 2;
      justify-self: center;
      align-self: center;
      width: 60px;
      height: 60px;
      font-size: 20px;
      z-index: 1;
    }
    .card {
      grid-column: 1;
      margin-inline: 12px;
    }
    .step.below .card {
      grid-row: 3;
      align-self: start;
      margin-top: 14px;
    }
    .step.above .card {
      grid-row: 1;
      align-self: end;
      margin-bottom: 14px;
    }
    /* Short connector between card and node. */
    .card::after {
      content: '';
      position: absolute;
      left: 50%;
      width: 2px;
      height: 14px;
      margin-left: -1px;
      background: var(--c);
    }
    .step.below .card::after {
      bottom: 100%;
    }
    .step.above .card::after {
      top: 100%;
    }
  }

  @media (min-width: 860px) and (max-width: 1200px) {
    .flow {
      --slot: 336px;
    }
    .card {
      margin-inline: 7px;
      padding: 14px 14px 12px;
    }
    .card p {
      font-size: 13px;
    }
  }
</style>
