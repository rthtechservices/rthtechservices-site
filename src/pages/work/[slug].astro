---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { caseStudies } from '../../data/case-studies';

export function getStaticPaths() {
  return caseStudies.map((study) => ({
    params: { slug: study.slug },
    props: { study },
  }));
}

const { study } = Astro.props;
const heroImage = `/images/work-${study.slug}.jpg`;
---

<BaseLayout title={`${study.title} — RTH Tech Services Inc.`} description={study.summary} active="work">
  <section class="rth-container intro">
    <a class="back" href="/work/">&larr; All work</a>
    <p class="rth-eyebrow"><span>{study.category}</span></p>
    <h1>{study.title}</h1>
    {study.status && (
      <div class="status-badge" aria-label={`Project status: ${study.status}`}>
        <span class="status-dot" aria-hidden="true"></span>
        {study.status}
      </div>
    )}
    <p class={`summary${study.context ? '' : ' summary--no-context'}`}>{study.summary}</p>
    {study.context && (
      <p class="context">{study.context}</p>
    )}
  </section>

  <section class="rth-container hero-wrap">
    <div class="hero">
      <img src={heroImage} alt={`${study.title} — screenshot`} fetchpriority="high" />
    </div>
  </section>

  <section class="rth-container two-col">
    <div>
      <h2>What it solves</h2>
      <ul class="solves">
        {study.whatItSolves.map((point) => <li>{point}</li>)}
      </ul>
    </div>
    <div>
      <h2>Technology stack</h2>
      <div class="stack">
        {study.stack.map((tech) => <span class="rth-chip">{tech}</span>)}
      </div>
    </div>
  </section>

  {study.role && (
    <section class="rth-container role-section">
      <h2>My role</h2>
      <p class="role-body">{study.role}</p>
    </section>
  )}

  {study.constraints && study.constraints.length > 0 && (
    <section class="rth-container constraints-section">
      <h2>Constraints</h2>
      <ul class="solves">
        {study.constraints.map((c) => <li>{c}</li>)}
      </ul>
    </section>
  )}

  <section class="rth-container highlights">
    <h2>Highlights</h2>
    <div class="feature-grid">
      {
        study.features.map((feat) => (
          <div class="feature">
            <div class="feature-title">{feat.title}</div>
            <p>{feat.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  {study.decisions && study.decisions.length > 0 && (
    <section class="rth-container decisions-section">
      <h2>Key decisions</h2>
      <div class="decision-list">
        {study.decisions.map((d) => (
          <div class="decision">
            <div class="decision-title">{d.title}</div>
            <p>{d.body}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="rth-container freeform">
    {
      study.sections.map((sec) => (
        <div>
          <h2 class="sec-heading">{sec.heading}</h2>
          <p class="sec-body">{sec.body}</p>
        </div>
      ))
    }
  </section>

  {study.outcomes && study.outcomes.length > 0 && (
    <section class="rth-container outcomes-section">
      <h2>Outcomes</h2>
      <ul class="solves">
        {study.outcomes.map((o) => <li>{o}</li>)}
      </ul>
    </section>
  )}

  {study.screenshots && study.screenshots.length > 0 && (
    <section class="rth-container screenshots-section">
      <h2>Screenshots</h2>
      <div class="screenshot-grid">
        {study.screenshots.map((s) => (
          <figure class="screenshot">
            <img src={s.src} alt={s.alt} loading="lazy" />
            {s.caption && <figcaption>{s.caption}</figcaption>}
          </figure>
        ))}
      </div>
      {study.confidentialityNote && (
        <p class="confidentiality-note">{study.confidentialityNote}</p>
      )}
    </section>
  )}

  <section class="cta-band">
    <div class="rth-container band-inner">
      <div>
        <div class="band-title">Have a similar problem to solve?</div>
        <div class="band-sub">
          Let&rsquo;s talk about what a practical solution would look like for your organization.
        </div>
      </div>
      <a class="rth-cta" href="/contact/">Discuss a project</a>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    padding-top: 56px;
  }

  .back {
    font-family: var(--font-ui);
    font-size: 13.5px;
    color: var(--text-faint);
    text-decoration: none;
    transition: color var(--ease);
  }
  .back:hover {
    color: #e7e6f0;
  }
  .back:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
  }

  .rth-eyebrow {
    margin: 22px 0 14px;
  }

  h1 {
    font-family: var(--font-ui);
    font-size: clamp(28px, 4vw, 38px);
    line-height: 1.2;
    color: var(--text-primary);
    margin: 0 0 16px;
    font-weight: 600;
  }

  /* --- Project status badge --- */
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-ui);
    font-size: 13px;
    color: var(--text-muted);
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 4px 12px 4px 10px;
    margin-bottom: 18px;
  }
  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--blue);
    box-shadow: 0 0 5px rgba(92, 193, 255, 0.7);
    flex-shrink: 0;
  }

  .summary {
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--text-bio);
    max-width: 70ch;
    margin: 0 0 16px;
    font-weight: 600;
  }

  /* When no context paragraph follows, preserve the original 40px gap to the hero. */
  .summary--no-context {
    margin-bottom: 40px;
  }

  .context {
    font-size: 15px;
    line-height: 1.75;
    color: var(--text-bio);
    max-width: 74ch;
    margin: 0 0 40px;
  }

  /* When no context paragraph follows, the intro bottom spacing comes from the
     .summary--no-context modifier class above. */

  /* --- Hero image --- */
  .hero-wrap {
    padding-bottom: 64px;
  }
  .hero {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 5px;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08);
    overflow: hidden;
    background: var(--surface-card-alt);
  }
  .hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* --- What it solves / stack --- */
  .two-col {
    padding-bottom: 72px;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 56px;
  }

  h2 {
    font-family: var(--font-ui);
    font-size: 23px;
    color: var(--text-primary);
    margin: 0 0 18px;
    font-weight: 600;
  }

  .solves {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .solves li {
    position: relative;
    padding-left: 18px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-body);
  }
  .solves li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--blue);
    box-shadow: 0 0 6px rgba(92, 193, 255, 0.6);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* --- Role --- */
  .role-section {
    padding-bottom: 64px;
  }
  .role-body {
    font-size: 15px;
    line-height: 1.75;
    color: var(--text-bio);
    max-width: 74ch;
    margin: 0;
  }

  /* --- Constraints --- */
  .constraints-section {
    padding-bottom: 64px;
  }

  /* --- Highlights --- */
  .highlights {
    padding-bottom: 80px;
  }
  .highlights h2 {
    margin-bottom: 26px;
  }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
  }
  .feature {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-card);
    padding: 24px 22px;
  }
  .feature-title {
    font-family: var(--font-ui);
    font-size: 16.5px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 8px;
  }
  .feature p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }

  /* --- Key decisions --- */
  .decisions-section {
    padding-bottom: 80px;
  }
  .decision-list {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .decision {
    border-left: 2px solid var(--blue);
    padding-left: 18px;
  }
  .decision-title {
    font-family: var(--font-ui);
    font-size: 15.5px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 6px;
  }
  .decision p {
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--text-body);
    margin: 0;
  }

  /* --- Freeform sections --- */
  .freeform {
    padding-bottom: 88px;
    display: flex;
    flex-direction: column;
    gap: 44px;
  }
  .sec-heading {
    font-size: 21px;
    margin: 0 0 12px;
  }
  .sec-body {
    font-size: 15px;
    line-height: 1.75;
    color: var(--text-bio);
    margin: 0;
    max-width: 78ch;
  }

  /* --- Outcomes --- */
  .outcomes-section {
    padding-bottom: 80px;
  }

  /* --- Screenshots --- */
  .screenshots-section {
    padding-bottom: 80px;
  }
  .screenshot-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(420px, 1fr));
    gap: 28px;
    margin-bottom: 20px;
  }
  .screenshot {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface-card-alt);
  }
  .screenshot img {
    width: 100%;
    height: auto;
    display: block;
  }
  .screenshot figcaption {
    font-size: 13px;
    color: var(--text-muted);
    padding: 10px 14px;
    line-height: 1.5;
  }
  .confidentiality-note {
    font-size: 13px;
    color: var(--text-faint);
    font-style: italic;
    margin: 0;
    max-width: 74ch;
  }

  /* --- Bottom CTA band --- */
  .cta-band {
    background: var(--surface-band);
    border-top: 1px solid var(--border-faint);
    border-bottom: 1px solid var(--border-faint);
  }
  .band-inner {
    padding-top: 52px;
    padding-bottom: 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .band-title {
    font-family: var(--font-ui);
    font-size: 21px;
    color: var(--text-primary);
    font-weight: 600;
    margin-bottom: 6px;
  }
  .band-sub {
    font-size: 14.5px;
    color: var(--text-muted);
  }

  @media (max-width: 859px) {
    .intro {
      padding-top: 48px;
    }
    .two-col {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .feature-grid {
      grid-template-columns: 1fr;
    }
    .screenshot-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
