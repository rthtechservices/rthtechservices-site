---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { caseStudies } from '../../data/case-studies';

export function getStaticPaths() {
  return caseStudies.map((study) => ({
    params: { slug: study.slug },
    props: { study },
  }));
}

const { study } = Astro.props;
const heroImage = `/images/work-${study.slug}.jpg`;
---

<BaseLayout title={`${study.title} — RTH Tech Services Inc.`} description={study.summary} active="work">
  <section class="rth-container intro">
    <a class="back" href="/work/">&larr; All work</a>
    <p class="rth-eyebrow"><span>{study.category}</span></p>
    <h1>{study.title}</h1>
    <p class="summary">{study.summary}</p>
  </section>

  <section class="rth-container hero-wrap">
    <div class="hero">
      <img src={heroImage} alt={`${study.title} — screenshot`} fetchpriority="high" />
    </div>
  </section>

  <section class="rth-container two-col">
    <div>
      <h2>What it solves</h2>
      <ul class="solves">
        {study.whatItSolves.map((point) => <li>{point}</li>)}
      </ul>
    </div>
    <div>
      <h2>Technology stack</h2>
      <div class="stack">
        {study.stack.map((tech) => <span class="rth-chip">{tech}</span>)}
      </div>
    </div>
  </section>

  <section class="rth-container highlights">
    <h2>Highlights</h2>
    <div class="feature-grid">
      {
        study.features.map((feat) => (
          <div class="feature">
            <div class="feature-title">{feat.title}</div>
            <p>{feat.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="rth-container freeform">
    {
      study.sections.map((sec) => (
        <div>
          <h2 class="sec-heading">{sec.heading}</h2>
          <p class="sec-body">{sec.body}</p>
        </div>
      ))
    }
  </section>

  <section class="cta-band">
    <div class="rth-container band-inner">
      <div>
        <div class="band-title">Have a similar problem to solve?</div>
        <div class="band-sub">
          Let&rsquo;s talk about what a practical solution would look like for your organization.
        </div>
      </div>
      <a class="rth-cta" href="/contact/">Discuss a project</a>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    padding-top: 56px;
  }

  .back {
    font-family: var(--font-ui);
    font-size: 13.5px;
    color: var(--text-faint);
    text-decoration: none;
    transition: color var(--ease);
  }
  .back:hover {
    color: #e7e6f0;
  }
  .back:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
  }

  .rth-eyebrow {
    margin: 22px 0 14px;
  }

  h1 {
    font-family: var(--font-ui);
    font-size: clamp(28px, 4vw, 38px);
    line-height: 1.2;
    color: var(--text-primary);
    margin: 0 0 16px;
    font-weight: 600;
  }

  .summary {
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--text-bio);
    max-width: 70ch;
    margin: 0 0 40px;
  }

  /* --- Hero image --- */
  .hero-wrap {
    padding-bottom: 64px;
  }
  .hero {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 5px;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08);
    overflow: hidden;
    background: var(--surface-card-alt);
  }
  .hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* --- What it solves / stack --- */
  .two-col {
    padding-bottom: 72px;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 56px;
  }

  h2 {
    font-family: var(--font-ui);
    font-size: 23px;
    color: var(--text-primary);
    margin: 0 0 18px;
    font-weight: 600;
  }

  .solves {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .solves li {
    position: relative;
    padding-left: 18px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-body);
  }
  .solves li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--blue);
    box-shadow: 0 0 6px rgba(92, 193, 255, 0.6);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* --- Highlights --- */
  .highlights {
    padding-bottom: 80px;
  }
  .highlights h2 {
    margin-bottom: 26px;
  }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
  }
  .feature {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-card);
    padding: 24px 22px;
  }
  .feature-title {
    font-family: var(--font-ui);
    font-size: 16.5px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 8px;
  }
  .feature p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }

  /* --- Freeform sections --- */
  .freeform {
    padding-bottom: 88px;
    display: flex;
    flex-direction: column;
    gap: 44px;
  }
  .sec-heading {
    font-size: 21px;
    margin: 0 0 12px;
  }
  .sec-body {
    font-size: 15px;
    line-height: 1.75;
    color: var(--text-bio);
    margin: 0;
    max-width: 78ch;
  }

  /* --- Bottom CTA band --- */
  .cta-band {
    background: var(--surface-band);
    border-top: 1px solid var(--border-faint);
    border-bottom: 1px solid var(--border-faint);
  }
  .band-inner {
    padding-top: 52px;
    padding-bottom: 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .band-title {
    font-family: var(--font-ui);
    font-size: 21px;
    color: var(--text-primary);
    font-weight: 600;
    margin-bottom: 6px;
  }
  .band-sub {
    font-size: 14.5px;
    color: var(--text-muted);
  }

  @media (max-width: 859px) {
    .intro {
      padding-top: 48px;
    }
    .two-col {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .feature-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
