---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found — RTH Tech Services Inc."
  description="The page you were looking for doesn't exist."
>
  <section class="rth-container notfound">
    <p class="code">404</p>
    <h1>Page not found</h1>
    <p class="body">
      The page you were looking for doesn&rsquo;t exist, or has moved. Try the work index, or get in
      touch if you followed a link that should have worked.
    </p>
    <div class="cta-row">
      <a class="rth-cta" href="/">Back to home</a>
      <a class="text-link" href="/work/">View selected work</a>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-top: 96px;
    padding-bottom: 120px;
    max-width: 640px;
  }
  .code {
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--blue);
    margin: 0 0 12px;
  }
  h1 {
    font-family: var(--font-ui);
    font-size: clamp(28px, 4vw, 40px);
    color: var(--text-primary);
    font-weight: 600;
    margin: 0 0 18px;
  }
  .body {
    font-family: var(--font-body);
    font-size: 16.5px;
    line-height: 1.75;
    color: var(--text-bio);
    margin: 0 0 32px;
  }
  .cta-row {
    display: flex;
    gap: 18px;
    align-items: center;
    flex-wrap: wrap;
  }
  .text-link {
    text-decoration: none;
    color: #e7e6f0;
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 600;
    border-bottom: 2px solid rgba(255, 255, 255, 0.25);
    padding-bottom: 3px;
  }
  .text-link:hover {
    border-bottom-color: var(--blue);
    color: var(--text-primary);
  }
</style>
