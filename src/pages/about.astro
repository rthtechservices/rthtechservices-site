---
import BaseLayout from '../layouts/BaseLayout.astro';

const careerStages = [
  {
    title: 'Support & systems administration',
    body: 'The early years built the habits that still matter: reproduce the problem, inspect the environment, understand dependencies, and fix the cause rather than the symptom.',
  },
  {
    title: 'Data, SQL & reporting',
    body: 'Database analysis grew into SQL Server, SSRS and the work of turning business questions into reliable definitions, queries and reporting people can trust.',
  },
  {
    title: 'Enterprise operations & delivery',
    body: 'Enterprise IT added formal change, risk, resilience, stakeholder coordination, documentation, testing and the reality that technically correct is not always operationally successful.',
  },
  {
    title: 'Consulting & product development',
    body: 'Independent consulting brought the pieces together: clarify the need, choose a supportable architecture, build the solution, explain it clearly and remain accountable for how it behaves.',
  },
];

const environments = [
  {
    title: 'Powerex, a subsidiary of BC Hydro',
    body: 'Enterprise IT operations, technical project delivery, governance, resilience, business continuity and work involving formal processes and cross-functional stakeholders.',
  },
  {
    title: 'Harper Grey, Farris, RBS & JFK Law',
    body: 'Legal and professional-services reporting, SQL, matter data, financial analysis, document workflows, collaboration and legal technology where accuracy and confidentiality are non-negotiable.',
  },
  {
    title: 'Tourism Whistler',
    body: 'Database analysis and operational information in a destination organization, where useful data had to connect directly to day-to-day business needs.',
  },
  {
    title: 'Escala & owner-operated organizations',
    body: 'Practical Microsoft 365, infrastructure, records, automation, hardware and vendor work designed to remain manageable for small teams and non-technical users.',
  },
];

const selectedExperience = [
  'Across Harper Grey LLP, Farris LLP and RBS LLP, I have worked with a combined portfolio of more than 400 SSRS reports, SQL analyses and Excel reporting workbooks.',
  'I have designed and supported reporting around Thomson Reuters Elite 3E data, including financial, matter, timekeeper, WIP, accounts-receivable, profitability and forecasting requirements.',
  'My Microsoft 365 work spans SharePoint, Power Automate, document governance, external collaboration, searchable records and custom user experiences where out-of-the-box tools are not enough.',
  'At Powerex, I worked in enterprise IT operations and project environments where resilience, access, formal change, documentation and business continuity were part of delivery rather than optional extras.',
  'Through RTH Tech Services Inc., I act as a practical point of accountability across business analysis, reporting, automation, Microsoft platforms, infrastructure and technical planning.',
  'TaskDesk and Fiscal Desk are production applications that continue to evolve as their workflows, data models and supporting capabilities are refined.',
];

const selectedRoles = [
  {
    title: 'Database Analyst — Tourism Whistler',
    body: 'Database analysis, operational information and data quality in a destination and tourism organization.',
  },
  {
    title: 'Enterprise IT operations and project delivery — Powerex, a subsidiary of BC Hydro',
    body: 'Enterprise operations, technical project delivery, formal change, resilience, business continuity, governance and documentation.',
  },
  {
    title: 'Legal reporting and technology consulting — Harper Grey LLP, Farris LLP, RBS LLP and JFK Law LLP',
    body: 'SQL, SSRS, reporting, legal technology, workflow and Microsoft 365 in environments where clarity and accuracy matter.',
  },
  {
    title: 'Principal — RTH Tech Services Inc.',
    body: 'Selected consulting, systems analysis, reporting, automation, Microsoft 365 and custom internal software.',
  },
];

const credentials = [
  'ITIL Foundation Certificate in IT Service Management',
  'Microsoft Certified Technology Specialist: SharePoint 2010, Configuration',
  'Microsoft Certified Technology Specialist: SQL Server 2008, Implementation and Maintenance',
  'Studies at RMIT University, 2003–2004',
];

const howIWork = [
  {
    title: 'Business analysis first',
    body: 'Every engagement starts with understanding the actual operational problem, not just the requested feature, so the solution addresses root causes.',
  },
  {
    title: 'Practical architecture',
    body: "The right-sized solution for the organization — not the most impressive architecture, and not enterprise tooling the team can't realistically maintain.",
  },
  {
    title: 'Traceable decisions',
    body: 'Requirements, assumptions, changes and operational decisions are documented so the solution can be understood later rather than reconstructed from folklore.',
  },
  {
    title: 'Built for handoff',
    body: 'Documentation and governance are part of delivery, not an afterthought — systems should remain supportable after the engagement ends.',
  },
  {
    title: 'Useful communication',
    body: 'Technical detail matters, but it has to be translated into risks, options, decisions and next actions that the audience can actually use.',
  },
];
---

<BaseLayout
  title="About Rohan Hare — RTH Tech Services Inc."
  description="Rohan Hare is a Vancouver IT consultant with a career beginning in 2005 across enterprise operations, legal reporting, Microsoft 365, automation and custom software."
  active="about"
>
  <section class="rth-container hero">
    <div class="portrait">
      <div class="glow" aria-hidden="true"></div>
      <img class="portrait-slot" src="/images/portrait-about.png" alt="Rohan Hare" />
    </div>

    <div>
      <p class="eyebrow">About</p>
      <h1>Rohan Hare</h1>
      <p>
        Most of my career has been spent in the space between technology and operations: the point
        where a business knows something is inefficient, unreliable or harder than it should be,
        but the solution does not fit neatly into one product or job description.
      </p>
      <p>
        I began my IT career in May 2005 in hands-on support and systems administration. Over time,
        that work expanded into SQL Server, enterprise reporting, SharePoint, infrastructure,
        automation, technical project delivery, business continuity, governance and custom software
        development. The titles changed; the underlying role did not. I was usually expected to
        understand how the pieces connected, find the actual cause of the problem and make the
        result usable by people who did not want a lecture on the machinery underneath it.
      </p>
      <p>
        I have worked inside large enterprise environments, with legal and professional-services
        firms, in tourism, with property-management organizations and with smaller businesses where
        one person may be responsible for an entire technology estate. Those environments demand
        different tools, but reward the same habits: listen carefully, verify assumptions, document
        decisions, protect the organization from avoidable risk and do not build something more
        complicated than the team can realistically support.
      </p>
      <p class="last">
        Today, RTH Tech Services Inc. is the vehicle through which I take on selected consulting and
        development work. I am most useful when a problem crosses boundaries &mdash; data and
        workflow, reporting and business interpretation, infrastructure and access, or technology
        and the people who have to live with it afterward.
      </p>
      <div class="cta-row">
        <a class="rth-cta" href="/contact/">Discuss a project</a>
        <a class="text-link" href="/work/">View selected work</a>
      </div>
    </div>
  </section>

  <section class="rth-container section-block" aria-labelledby="through-line-heading">
    <div class="section-intro">
      <p class="eyebrow">The career through-line</p>
      <h2 id="through-line-heading">Broad experience, built one connected layer at a time.</h2>
      <p>
        My background is broad, but it is not random. Each stage added another part of the same core
        capability: understanding operational systems well enough to improve them responsibly.
      </p>
    </div>
    <div class="career-grid">
      {
        careerStages.map((item) => (
          <article class="content-card">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="rth-container section-block" aria-labelledby="environments-heading">
    <div class="section-intro">
      <p class="eyebrow">Where I have worked</p>
      <h2 id="environments-heading">Environments that shaped my approach.</h2>
      <p>
        Employer and client names provide context, but the useful part is what those environments
        required: accuracy, judgement, adaptability and systems that keep working after delivery.
      </p>
    </div>
    <div class="environment-grid">
      {
        environments.map((item) => (
          <article class="environment-item">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="rth-container section-block selected" aria-labelledby="selected-heading">
    <div class="section-intro">
      <p class="eyebrow">Selected experience</p>
      <h2 id="selected-heading">A few useful points of scale and responsibility.</h2>
    </div>
    <ul class="experience-list">
      {selectedExperience.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="rth-container section-block roles-credentials" aria-labelledby="roles-credentials-heading">
    <div class="section-intro">
      <p class="eyebrow">Selected roles & credentials</p>
      <h2 id="roles-credentials-heading">
        Experience across operational, enterprise and professional-services environments.
      </h2>
      <p>
        These entries provide selected role context and professional foundations, including
        historical certifications and education.
      </p>
    </div>
    <div class="roles-credentials-grid">
      <div>
        <h3 class="subheading">Role context</h3>
        <ul class="roles-list">
          {selectedRoles.map((item) => (
            <li>
              <strong>{item.title}</strong>
              <p>{item.body}</p>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="subheading">Historical credentials & education</h3>
        <ul class="credential-list">
          {credentials.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="rth-container how" aria-labelledby="how-heading">
    <div class="section-intro">
      <p class="eyebrow">Working principles</p>
      <h2 id="how-heading">How I work</h2>
    </div>
    <div class="how-grid">
      {
        howIWork.map((item) => (
          <article class="how-item">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: 64px;
    padding-bottom: 88px;
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    gap: 64px;
    align-items: start;
  }

  .portrait {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
  }
  .glow {
    position: absolute;
    inset: -10%;
    background: radial-gradient(
      closest-side,
      rgba(92, 193, 255, 0.1),
      rgba(143, 0, 255, 0.05) 60%,
      transparent 75%
    );
    z-index: 0;
  }
  .portrait-slot {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .eyebrow {
    font-size: 13px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-faint);
    font-weight: 600;
    margin: 0 0 14px;
  }

  h1 {
    font-family: var(--font-ui);
    font-size: clamp(28px, 4vw, 36px);
    color: var(--text-primary);
    margin: 0 0 22px;
    font-weight: 600;
  }

  .hero p {
    font-size: 16px;
    line-height: 1.8;
    color: var(--text-body);
    margin: 0 0 20px;
  }
  .hero p.last {
    margin-bottom: 34px;
  }

  .cta-row {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    align-items: center;
  }

  .text-link {
    text-decoration: none;
    color: #e7e6f0;
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 600;
    border-bottom: 2px solid rgba(255, 255, 255, 0.25);
    padding-bottom: 3px;
    transition: color var(--ease), border-color var(--ease);
  }
  .text-link:hover {
    border-bottom-color: var(--blue);
    color: var(--text-primary);
  }
  .text-link:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
  }

  .section-block,
  .how {
    padding-bottom: 96px;
  }

  .section-intro {
    border-top: 1px solid var(--border-faint);
    padding-top: 40px;
    margin-bottom: 32px;
  }

  .section-intro h2 {
    font-family: var(--font-ui);
    font-size: clamp(23px, 3vw, 28px);
    line-height: 1.3;
    color: var(--text-primary);
    margin: 0 0 12px;
    font-weight: 600;
  }

  .section-intro > p:last-child {
    max-width: 72ch;
    margin: 0;
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .career-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }

  .content-card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-card);
    padding: 24px 22px;
  }

  .content-card h3,
  .environment-item h3,
  .how-item h3 {
    font-family: var(--font-ui);
    font-size: 16.5px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 9px;
  }

  .content-card p,
  .environment-item p,
  .how-item p {
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-muted);
    margin: 0;
  }

  .environment-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 56px;
    row-gap: 34px;
  }

  .environment-item {
    border-left: 2px solid rgba(92, 193, 255, 0.55);
    padding-left: 20px;
  }

  .experience-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px 34px;
  }

  .experience-list li {
    position: relative;
    padding: 0 0 0 20px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-body);
  }

  .experience-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--blue);
    box-shadow: 0 0 6px rgba(92, 193, 255, 0.55);
  }

  .roles-credentials-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: 28px;
    align-items: start;
  }

  .subheading {
    margin: 0 0 14px;
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--text-primary);
  }

  .roles-list,
  .credential-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .roles-list li,
  .credential-list li {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-card);
    padding: 14px 16px;
  }

  .roles-list li strong {
    display: block;
    margin: 0 0 6px;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--text-primary);
    font-family: var(--font-ui);
    font-weight: 600;
  }

  .roles-list li p {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .credential-list li {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-body);
  }

  .how-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 24px;
  }

  .how-item {
    padding-top: 18px;
    border-top: 2px solid rgba(255, 255, 255, 0.12);
  }

  @media (max-width: 1080px) {
    .career-grid,
    .how-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 859px) {
    .hero {
      padding-top: 48px;
      padding-bottom: 64px;
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .section-block,
    .how {
      padding-bottom: 64px;
    }
    .career-grid,
    .environment-grid,
    .experience-list,
    .roles-credentials-grid,
    .how-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
