---
import BaseLayout from '../layouts/BaseLayout.astro';

const howIWork = [
  {
    title: 'Business analysis first',
    body: 'Every engagement starts with understanding the actual operational problem, not just the requested feature, so the solution addresses root causes.',
  },
  {
    title: 'Built for handoff',
    body: 'Documentation and governance are part of delivery, not an afterthought — systems remain supportable after the engagement ends.',
  },
  {
    title: 'No unnecessary complexity',
    body: "The right-sized solution for the organization — not the most impressive architecture, and not enterprise tooling the team can't maintain.",
  },
];
---

<BaseLayout
  title="About Rohan Hare — RTH Tech Services Inc."
  description="IT consultant, systems analyst and solutions developer specializing in automation, reporting and Microsoft 365 for professional-services organizations."
  active="about"
>
  <section class="rth-container hero">
    <div class="portrait">
      <div class="glow" aria-hidden="true"></div>
      <img class="portrait-slot" src="/images/portrait-about.png" alt="Rohan Hare" />
    </div>

    <div>
      <p class="eyebrow">About</p>
      <h1>Rohan Hare</h1>
      <p>
        I design and implement practical technology solutions for organizations with complex
        operational, reporting and information-management needs. My work spans business process
        automation, data and reporting, Microsoft&nbsp;365, SharePoint, Power Platform, SQL,
        infrastructure, systems integration and custom application development.
      </p>
      <p>
        I specialize in turning inefficient, fragmented or overly manual processes into reliable
        systems that are easier to operate, support and scale. My approach combines technical
        implementation with business analysis, documentation, governance and long-term
        maintainability.
      </p>
      <p class="last">
        Through RTH Tech Services Inc., I provide consulting and development services to
        professional-services firms, property-management organizations and other businesses that
        need experienced technical problem-solving without unnecessary enterprise theatre.
      </p>
      <div class="cta-row">
        <a class="rth-cta" href="/contact/">Discuss a project</a>
        <a class="text-link" href="/work/">View selected work</a>
      </div>
    </div>
  </section>

  <section class="rth-container how">
    <h2>How I work</h2>
    <div class="how-grid">
      {
        howIWork.map((item) => (
          <div>
            <div class="how-title">{item.title}</div>
            <p class="how-body">{item.body}</p>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: 64px;
    padding-bottom: 88px;
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 64px;
    align-items: start;
  }

  /* Ambient glow behind the cutout portrait — not a frame. */
  .portrait {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
  }
  .glow {
    position: absolute;
    inset: -10%;
    background: radial-gradient(
      closest-side,
      rgba(92, 193, 255, 0.1),
      rgba(143, 0, 255, 0.05) 60%,
      transparent 75%
    );
    z-index: 0;
  }
  .portrait-slot {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .eyebrow {
    font-size: 13px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-faint);
    font-weight: 600;
    margin: 0 0 16px;
  }

  h1 {
    font-family: var(--font-ui);
    font-size: clamp(26px, 4vw, 34px);
    color: var(--text-primary);
    margin: 0 0 22px;
    font-weight: 600;
  }

  .hero p {
    font-size: 16px;
    line-height: 1.8;
    color: var(--text-body);
    margin: 0 0 20px;
  }
  .hero p.last {
    margin-bottom: 34px;
  }

  .cta-row {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    align-items: center;
  }

  .text-link {
    text-decoration: none;
    color: #e7e6f0;
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 600;
    border-bottom: 2px solid rgba(255, 255, 255, 0.25);
    padding-bottom: 3px;
    transition: color var(--ease), border-color var(--ease);
  }
  .text-link:hover {
    border-bottom-color: var(--blue);
    color: var(--text-primary);
  }
  .text-link:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
  }

  /* --- How I work --- */
  .how {
    padding-bottom: 96px;
  }
  .how h2 {
    font-family: var(--font-ui);
    font-size: 24px;
    color: var(--text-primary);
    margin: 0 0 32px;
    font-weight: 600;
    border-top: 1px solid var(--border-faint);
    padding-top: 40px;
  }
  .how-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .how-title {
    font-family: var(--font-ui);
    font-size: 17px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 8px;
  }
  .how-body {
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--text-muted);
    margin: 0;
  }

  @media (max-width: 859px) {
    .hero {
      padding-top: 48px;
      padding-bottom: 56px;
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .how-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
