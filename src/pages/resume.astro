---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  RESUME_PDF,
  RESUME_PDF_LABEL,
  resumeSummary,
  resumeExperience,
  resumeCapabilities,
  resumeTechnical,
  resumeEducation,
} from '../data/resume';
---

<BaseLayout
  title="Résumé — Rohan Hare, RTH Tech Services Inc."
  description="Résumé for Rohan Hare: 17+ years of Canadian IT experience across reporting and SQL, enterprise applications, Microsoft 365, automation and project delivery."
  active="about"
>
  <section class="rth-container hero">
    <p class="eyebrow">Résumé</p>
    <h1>Rohan Hare</h1>
    <p class="role">IT Systems Analyst &middot; Business Systems &middot; Enterprise Applications &middot; SQL &middot; Automation</p>
    <p class="summary">{resumeSummary}</p>
    <div class="cta-row">
      <a class="rth-cta" href={RESUME_PDF} download>Download PDF</a>
      <a class="text-link" href="/contact/">Discuss a project</a>
    </div>
    <p class="note">
      PDF, {RESUME_PDF_LABEL}. Contact details are intentionally left off; please use the
      <a href="/contact/">contact form</a>. Figures such as report counts and lines of SQL are my own
      counts and are approximate.
    </p>
  </section>

  <section class="rth-container block" aria-labelledby="experience-heading">
    <div class="block-head">
      <h2 id="experience-heading">Professional experience</h2>
    </div>
    <div class="employers">
      {
        resumeExperience.map((emp) => (
          <article class="employer">
            <header>
              <h3>{emp.name}</h3>
              <span class="loc">{emp.location}</span>
            </header>
            {emp.blurb && <p class="blurb">{emp.blurb}</p>}
            {emp.roles.map((role) => (
              <div class="role-block">
                <div class="role-head">
                  <h4>{role.title}</h4>
                  <span class="dates">
                    {role.dates}
                    {role.note && <span class="role-note"> ({role.note})</span>}
                  </span>
                </div>
                <ul>
                  {role.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </div>
            ))}
          </article>
        ))
      }
    </div>
  </section>

  <section class="rth-container block" aria-labelledby="capabilities-heading">
    <div class="block-head">
      <h2 id="capabilities-heading">Core capabilities</h2>
    </div>
    <div class="cap-grid">
      {
        resumeCapabilities.map((c) => (
          <div class="cap">
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="rth-container block" aria-labelledby="technical-heading">
    <div class="block-head">
      <h2 id="technical-heading">Technical profile</h2>
    </div>
    <dl class="tech">
      {
        resumeTechnical.map((t) => (
          <div>
            <dt>{t.label}</dt>
            <dd>{t.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="rth-container block last" aria-labelledby="education-heading">
    <div class="block-head">
      <h2 id="education-heading">Education &amp; certifications</h2>
    </div>
    <ul class="edu">
      {resumeEducation.map((e) => <li>{e}</li>)}
    </ul>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: 64px;
    padding-bottom: 56px;
    max-width: 920px;
  }
  .eyebrow {
    font-size: 13px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-faint);
    font-weight: 600;
    margin: 0 0 14px;
  }
  h1 {
    font-family: var(--font-ui);
    font-size: clamp(28px, 4vw, 36px);
    color: var(--text-primary);
    margin: 0 0 10px;
    font-weight: 600;
  }
  .role {
    margin: 0 0 22px;
    font-size: 13.5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .summary {
    font-size: 16px;
    line-height: 1.8;
    color: var(--text-body);
    margin: 0 0 30px;
    max-width: 78ch;
  }
  .cta-row {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    align-items: center;
  }
  .text-link {
    text-decoration: none;
    color: #e7e6f0;
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 600;
    border-bottom: 2px solid rgba(255, 255, 255, 0.25);
    padding-bottom: 3px;
    transition: color var(--ease), border-color var(--ease);
  }
  .text-link:hover {
    border-bottom-color: var(--blue);
    color: var(--text-primary);
  }
  .text-link:focus-visible,
  .note a:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
  }
  .note {
    margin: 22px 0 0;
    max-width: 78ch;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text-faint);
  }
  .note a {
    color: var(--blue);
  }

  .block {
    max-width: 920px;
    padding-bottom: 56px;
  }
  .block.last {
    padding-bottom: 96px;
  }
  .block-head {
    border-bottom: 1px solid var(--border-faint);
    padding-bottom: 14px;
    margin-bottom: 28px;
  }
  .block-head h2 {
    font-family: var(--font-ui);
    font-size: 24px;
    margin: 0;
    color: var(--text-primary);
    font-weight: 600;
  }

  .employers {
    display: grid;
    gap: 44px;
  }
  .employer header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
  }
  .employer h3 {
    font-family: var(--font-ui);
    font-size: 19px;
    margin: 0;
    color: var(--text-primary);
    font-weight: 600;
  }
  .loc {
    font-size: 13.5px;
    color: var(--text-faint);
  }
  .blurb {
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .role-block {
    margin-top: 22px;
    border-left: 2px solid rgba(92, 193, 255, 0.55);
    padding-left: 20px;
  }
  .role-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 20px;
    margin-bottom: 10px;
  }
  .role-head h4 {
    font-family: var(--font-ui);
    font-size: 16px;
    margin: 0;
    color: var(--text-primary);
    font-weight: 600;
  }
  .dates {
    font-size: 13.5px;
    color: var(--text-muted);
  }
  .role-note {
    color: var(--text-faint);
  }
  .role-block ul {
    margin: 0;
    padding-left: 18px;
    display: grid;
    gap: 8px;
  }
  .role-block li {
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--text-body);
  }

  .cap-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px 40px;
  }
  .cap h3 {
    font-family: var(--font-ui);
    font-size: 15.5px;
    margin: 0 0 6px;
    color: var(--text-primary);
    font-weight: 600;
  }
  .cap p {
    margin: 0;
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-muted);
  }

  .tech {
    margin: 0;
    display: grid;
    gap: 16px;
  }
  .tech dt {
    font-family: var(--font-ui);
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-faint);
    font-weight: 600;
    margin-bottom: 3px;
  }
  .tech dd {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-body);
  }

  .edu {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .edu li {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-card);
    padding: 14px 16px;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-body);
  }

  @media (max-width: 859px) {
    .hero {
      padding-top: 48px;
      padding-bottom: 40px;
    }
    .block {
      padding-bottom: 44px;
    }
    .cap-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
