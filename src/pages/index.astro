---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import { workItems } from '../data/work';
---

<BaseLayout
  title="Rohan Hare — IT Consultant, Systems Analyst & Solutions Developer"
  description="Practical systems, automation and reporting solutions for professional-services and property-management organizations, delivered through RTH Tech Services Inc."
>
  <section class="rth-container hero">
    <div>
      <p class="eyebrow">IT Consultant &middot; Systems Analyst &middot; Solutions Developer</p>
      <h1>
        Systems, automation and <span class="gradient"
          >reporting that solve real operational problems.</span
        >
      </h1>
      <p class="bio">
        I design and implement practical technology solutions for organizations with complex
        operational, reporting and information-management needs &mdash; spanning business process
        automation, data and reporting, Microsoft&nbsp;365, SharePoint, Power Platform, SQL,
        infrastructure and custom application development. Through RTH Tech Services Inc., I work
        with professional-services firms, property-management organizations and other businesses
        that need experienced technical problem-solving without unnecessary enterprise theatre.
      </p>
      <div class="cta-row">
        <a class="rth-cta" href="/contact/">Discuss a project</a>
        <a class="text-link" href="/work/">View selected work</a>
      </div>
    </div>

    <div class="portrait">
      <div class="glow" aria-hidden="true"></div>
      <img src="/images/portrait-home.png" alt="Rohan Hare" fetchpriority="high" />
    </div>
  </section>

  <section class="rth-container latest">
    <div class="section-head">
      <h2>Latest work</h2>
      <a class="view-all" href="/work/">View all work &rarr;</a>
    </div>
    <div class="card-grid">
      {workItems.map((item) => <WorkCard item={item} />)}
    </div>
  </section>
</BaseLayout>

<style>
  /* --- Hero --- */
  .hero {
    padding-top: 76px;
    padding-bottom: 88px;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 64px;
    align-items: center;
  }

  .eyebrow {
    font-size: 13px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-faint);
    font-family: var(--font-body);
    font-weight: 600;
    margin: 0 0 18px;
  }

  h1 {
    font-family: var(--font-ui);
    font-size: clamp(30px, 4.5vw, 44px);
    line-height: 1.18;
    color: var(--text-primary);
    margin: 0 0 22px;
    font-weight: 600;
  }

  /* The site's one intentional gradient-text treatment, reserved for this
     headline. Do not reuse elsewhere. */
  .gradient {
    background: linear-gradient(90deg, var(--blue), var(--purple));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .bio {
    font-family: var(--font-body);
    font-size: 16.5px;
    line-height: 1.75;
    color: var(--text-bio);
    max-width: 56ch;
    margin: 0 0 34px;
  }

  .cta-row {
    display: flex;
    gap: 18px;
    align-items: center;
    flex-wrap: wrap;
  }

  .text-link {
    text-decoration: none;
    color: #e7e6f0;
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 600;
    border-bottom: 2px solid rgba(255, 255, 255, 0.25);
    padding-bottom: 3px;
    transition: color var(--ease), border-color var(--ease);
  }
  .text-link:hover {
    border-bottom-color: var(--blue);
    color: var(--text-primary);
  }
  .text-link:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
  }

  /* The supplied portrait is a transparent cutout, so it gets the ambient
     glow treatment rather than the framed ring the design assumed. */
  .portrait {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
  }
  .glow {
    position: absolute;
    inset: -10%;
    background: radial-gradient(
      closest-side,
      rgba(92, 193, 255, 0.1),
      rgba(143, 0, 255, 0.05) 60%,
      transparent 75%
    );
    z-index: 0;
  }
  .portrait img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* --- Latest work --- */
  .latest {
    padding-bottom: 100px;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 1px solid var(--border-faint);
    padding-bottom: 20px;
    margin-bottom: 36px;
  }

  .section-head h2 {
    font-family: var(--font-ui);
    font-size: 26px;
    color: var(--text-primary);
    margin: 0;
    font-weight: 600;
  }

  .view-all {
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--blue);
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
  }
  .view-all:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  @media (max-width: 859px) {
    .hero {
      padding-top: 48px;
      padding-bottom: 56px;
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
