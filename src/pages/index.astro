---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import { featuredWorkItems } from '../data/work';

const experience = [
  {
    title: 'Enterprise operations',
    body: 'Technical project delivery, formal change, resilience, governance and business continuity in environments including Powerex, a subsidiary of BC Hydro.',
  },
  {
    title: 'Legal & professional services',
    body: 'Reporting, SQL, matter-centric systems, workflow and legal technology across Harper Grey LLP, Farris LLP, RBS LLP and JFK Law LLP.',
  },
  {
    title: 'Operational data & systems',
    body: 'Database analysis, information quality and practical systems work shaped by roles in organizations such as Tourism Whistler.',
  },
  {
    title: 'Consulting & product development',
    body: 'Owner-operated consulting, automation and production software built through RTH Tech Services Inc., including TaskDesk and Fiscal Desk.',
  },
];
---

<BaseLayout
  title="Rohan Hare — IT Consultant, Systems Analyst & Solutions Developer"
  description="Rohan Hare builds practical reporting, automation, Microsoft 365 and custom software solutions through RTH Tech Services Inc. in Vancouver, BC."
>
  <section class="rth-container hero">
    <div>
      <p class="eyebrow">IT Consultant &middot; Systems Analyst &middot; Solutions Developer</p>
      <h1>
        Systems, automation and <span class="gradient"
          >reporting that solve real operational problems.</span
        >
      </h1>
      <p class="bio">
        I build practical systems for organizations where the work is complicated, the data is
        messy, and the off-the-shelf answer never quite fits. Since beginning my IT career in 2005,
        I&rsquo;ve worked across enterprise operations, legal and professional-services reporting,
        Microsoft&nbsp;365, automation and custom software development.
      </p>
      <p class="principle">
        The common thread is simple: understand the real problem, build something supportable, and
        leave the organization with fewer moving parts than it started with.
      </p>
      <div class="cta-row">
        <a class="rth-cta" href="/contact/">Discuss a project</a>
        <a class="text-link" href="/work/">View selected work</a>
      </div>
    </div>

    <div class="portrait">
      <div class="glow" aria-hidden="true"></div>
      <img src="/images/portrait-home.png" alt="Rohan Hare" fetchpriority="high" />
    </div>
  </section>

  <div class="rth-artwork rth-artwork--blue-center-top">
    <section class="rth-container experience" aria-labelledby="experience-heading">
      <div class="section-head experience-head">
        <div>
          <p class="section-kicker">Experience in context</p>
          <h2 id="experience-heading">Different environments. The same practical standard.</h2>
        </div>
      </div>
      <div class="experience-grid">
        {
          experience.map((item) => (
            <article class="experience-item">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))
        }
      </div>
    </section>
  </div>

  <section class="rth-container latest">
    <div class="section-head">
      <div>
        <h2>Latest work</h2>
        <p class="work-note">
          Real operational needs, production tools and active builds &mdash; not concept mock-ups
          presented as finished products.
        </p>
      </div>
      <a class="view-all" href="/work/">View all work &rarr;</a>
    </div>
    <div class="card-grid">
      {featuredWorkItems.map((item) => <WorkCard item={item} />)}
    </div>
  </section>
</BaseLayout>

<style>
  /* --- Hero --- */
  .hero {
    padding-top: 76px;
    padding-bottom: 80px;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 64px;
    align-items: center;
  }

  .eyebrow,
  .section-kicker {
    font-size: 13px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-faint);
    font-family: var(--font-body);
    font-weight: 600;
    margin: 0 0 18px;
  }

  h1 {
    font-family: var(--font-ui);
    font-size: clamp(30px, 4.5vw, 44px);
    line-height: 1.18;
    color: var(--text-primary);
    margin: 0 0 22px;
    font-weight: 600;
  }

  /* The site's one intentional gradient-text treatment, reserved for this
     headline. Do not reuse elsewhere. */
  .gradient {
    background: linear-gradient(90deg, var(--blue), var(--purple));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .bio {
    font-family: var(--font-body);
    font-size: 16.5px;
    line-height: 1.75;
    color: var(--text-bio);
    max-width: 58ch;
    margin: 0 0 16px;
  }

  .principle {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 58ch;
    margin: 0 0 34px;
  }

  .cta-row {
    display: flex;
    gap: 18px;
    align-items: center;
    flex-wrap: wrap;
  }

  .text-link {
    text-decoration: none;
    color: #e7e6f0;
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 600;
    border-bottom: 2px solid rgba(255, 255, 255, 0.25);
    padding-bottom: 3px;
    transition: color var(--ease), border-color var(--ease);
  }
  .text-link:hover {
    border-bottom-color: var(--blue);
    color: var(--text-primary);
  }
  .text-link:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
  }

  .portrait {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
  }
  .glow {
    position: absolute;
    inset: -10%;
    background: radial-gradient(
      closest-side,
      rgba(92, 193, 255, 0.1),
      rgba(143, 0, 255, 0.05) 60%,
      transparent 75%
    );
    z-index: 0;
  }
  .portrait img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* --- Experience --- */
  .experience {
    padding-top: 40px;
    padding-bottom: 92px;
  }

  .experience-head {
    align-items: end;
  }

  .section-kicker {
    margin-bottom: 10px;
  }

  .experience h2 {
    font-family: var(--font-ui);
    font-size: clamp(22px, 3vw, 28px);
    color: var(--text-primary);
    margin: 0;
    font-weight: 600;
  }

  .experience-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .experience-item {
    border-left: 2px solid rgba(92, 193, 255, 0.55);
    padding-left: 18px;
  }

  .experience-item h3 {
    font-family: var(--font-ui);
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 8px;
  }

  .experience-item p {
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-muted);
    margin: 0;
  }

  /* --- Latest work --- */
  .latest {
    padding-bottom: 100px;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 32px;
    border-bottom: 1px solid var(--border-faint);
    padding-bottom: 20px;
    margin-bottom: 36px;
  }

  .section-head h2 {
    font-family: var(--font-ui);
    font-size: 26px;
    color: var(--text-primary);
    margin: 0;
    font-weight: 600;
  }

  .work-note {
    max-width: 66ch;
    margin: 8px 0 0;
    color: var(--text-faint);
    font-size: 13.5px;
    line-height: 1.55;
  }

  .view-all {
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--blue);
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
  }
  .view-all:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  @media (max-width: 1040px) {
    .experience-grid {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 32px;
    }
  }

  @media (max-width: 859px) {
    .hero {
      padding-top: 48px;
      padding-bottom: 56px;
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .experience {
      padding-top: 32px;
      padding-bottom: 64px;
    }
    .glow {
      inset: 0;
    }
    .experience-grid,
    .card-grid {
      grid-template-columns: 1fr;
    }
    .section-head {
      align-items: flex-start;
    }
  }
</style>
